@model LMSystem.Models.MyBorrowsViewModel
@{
    ViewData["Title"] = "My Borrowed Items";
}

<div class="page-container">
    <h1>My Borrowed Items</h1>
    <p style="color:#6b7280;">Everything you currently have checked out.</p>

    <h2 style="font-size:1.2rem; margin-top:30px;">Books</h2>
    <table class="data-table">
        <thead><tr><th>Title</th><th>Author</th><th>Due Date</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var b in Model.Books)
            {
                <tr>
                    <td>@b.Title</td>
                    <td>@b.Author</td>
                    <td>@b.DueDate?.ToString("yyyy-MM-dd")</td>
                    <td><a class="btn btn-borrow" asp-controller="Books" asp-action="Return" asp-route-id="@b.Id">Return</a></td>
                </tr>
            }
            @if (!Model.Books.Any())
            {
                <tr><td colspan="4" style="color:#9aa0ac;">Nothing borrowed.</td></tr>
            }
        </tbody>
    </table>

    <h2 style="font-size:1.2rem; margin-top:30px;">Magazines</h2>
    <table class="data-table">
        <thead><tr><th>Title</th><th>Issue</th><th>Due Date</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var m in Model.Magazines)
            {
                <tr>
                    <td>@m.Title</td>
                    <td>@m.Issue</td>
                    <td>@m.DueDate?.ToString("yyyy-MM-dd")</td>
                    <td><a class="btn btn-borrow" asp-controller="Magazines" asp-action="Return" asp-route-id="@m.Id">Return</a></td>
                </tr>
            }
            @if (!Model.Magazines.Any())
            {
                <tr><td colspan="4" style="color:#9aa0ac;">Nothing borrowed.</td></tr>
            }
        </tbody>
    </table>

    <h2 style="font-size:1.2rem; margin-top:30px;">Newspapers</h2>
    <table class="data-table">
        <thead><tr><th>Title</th><th>Date</th><th>Due Date</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var n in Model.Newspapers)
            {
                <tr>
                    <td>@n.Title</td>
                    <td>@n.Date.ToString("yyyy-MM-dd")</td>
                    <td>@n.DueDate?.ToString("yyyy-MM-dd")</td>
                    <td><a class="btn btn-borrow" asp-controller="Newspapers" asp-action="Return" asp-route-id="@n.Id">Return</a></td>
                </tr>
            }
            @if (!Model.Newspapers.Any())
            {
                <tr><td colspan="4" style="color:#9aa0ac;">Nothing borrowed.</td></tr>
            }
        </tbody>
    </table>
</div>